# ── Vultr Serverless Inference (REQUIRED: all agent LLM calls go here) ──
# Get a key from the Vultr console: Products → Serverless → Inference → API Keys
VULTR_INFERENCE_API_KEY=your_vultr_inference_api_key_here
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Pick a model available in your Vultr Inference account (see docs/VULTR_SETUP.md)
VULTR_MODEL=llama-3.3-70b-instruct

# ── Agent behavior ──
MAX_ATTEMPTS=4

# ── Sandbox limits (containment) ──
SANDBOX_IMAGE=sandbox-runner:latest
SANDBOX_TIMEOUT_SECONDS=15
SANDBOX_MEMORY=256m
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=128

# ── Server ──
CORS_ORIGINS=http://localhost:5173
